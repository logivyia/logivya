model SupportTicket {
  id                 String                      @id @default(cuid())
  publicId           String                      @unique
  clientRequestId    String?
  companyId          String
  tenantId           String
  createdById        String
  userId             String
  assignedToAdminId  String?
  subject            String
  title              String
  type               String
  category           String
  description        String                      @default("")
  source             String                      @default("WEB")
  status             SupportTicketStatus         @default(OPEN)
  priority           SupportTicketPriority       @default(NORMAL)
  priorityRank       Int                         @default(2)
  lastMessageAt      DateTime                    @default(now())
  lastUserMessageAt  DateTime?
  lastAdminMessageAt DateTime?
  firstAdminReplyAt  DateTime?
  userLastReadAt     DateTime?
  adminLastReadAt    DateTime?
  userUnreadCount    Int                         @default(0)
  adminUnreadCount   Int                         @default(0)
  resolvedAt         DateTime?
  closedAt           DateTime?
  company            Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy          User                        @relation("SupportTicketCreator", fields: [createdById], references: [id])
  assignedToAdmin    User?                       @relation("SupportTicketAssignee", fields: [assignedToAdminId], references: [id])
  messages           SupportTicketMessage[]
  audits             SupportTicketAudit[]
  notificationOutbox SupportNotificationOutbox[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([createdById, clientRequestId])
  @@index([companyId, status, lastMessageAt])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([createdById, createdAt])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([status, createdAt])
  @@index([category])
  @@index([type, createdAt])
  @@index([category, createdAt])
  @@index([createdAt])
  @@index([lastMessageAt])
  @@index([source, createdAt])
  @@index([status, priority, lastMessageAt])
  @@index([status, lastMessageAt(sort: Desc), id])
  @@index([createdById, lastMessageAt(sort: Desc), id])
  @@index([assignedToAdminId, status, lastMessageAt(sort: Desc)])
  @@index([priority, status, lastMessageAt(sort: Desc)])
  @@index([priorityRank, lastMessageAt, id])
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin, map: "SupportTicket_subject_trgm_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "SupportTicket_title_trgm_idx")
}

