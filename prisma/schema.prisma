model CompanyUser {
  id                     String                   @id @default(cuid())
  companyId              String
  userId                 String
  createdByUserId        String?
  role                   CompanyRole              @default(OPERATOR)
  status                 MembershipStatus         @default(ACTIVE)
  lifecycleState         MembershipLifecycleState
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy              User?                    @relation("CompanyMembershipCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  joinedAt               DateTime                 @default(now())
  seatActivatedAt        DateTime?                @default(now())
  activationCompletedAt  DateTime?
  sharedAccessExpiredAt  DateTime?
  detachedAt             DateTime?
  independentConvertedAt DateTime?
  suspendedAt            DateTime?
  removedAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  permissionOverrides    CompanyUserPermission[]

  @@unique([companyId, userId])
  @@index([userId])
  @@index([createdByUserId])
  @@index([companyId, lifecycleState])
  @@index([userId, lifecycleState])
}

model CompanyInvitation {
  id               String                     @id @default(cuid())
  companyId        String
  invitedByUserId  String
  acceptedByUserId String?
  email            String
  name             String
  role             CompanyRole                @default(OPERATOR)
  status           CompanyInvitationStatus    @default(PENDING)
  tokenHash        String                     @unique
  shortCodeHash    String?                    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  declinedAt       DateTime?
  revokedAt        DateTime?
  reservedSeat     Boolean                    @default(true)
  sentAt           DateTime?
  resendCount      Int                        @default(0)
  lastResentAt     DateTime?
  company          Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy        User                       @relation("CompanyInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?                      @relation("CompanyInvitationAcceptedUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  deliveries       InvitationDeliveryOutbox[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([companyId, status, expiresAt])
  @@index([email, status])
  @@index([invitedByUserId])
