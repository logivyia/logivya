  requiresMfa        Boolean           @default(true)
  lastElevatedAt     DateTime?
  createdByUserId    String?
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([role, isActive])
}

model AdminPermission {
  id          String                @id @default(cuid())
  code        String                @unique
  description String?
  roles       AdminRolePermission[]
  createdAt   DateTime              @default(now())
}

model AdminRolePermission {
  id           String            @id @default(cuid())
  role         PlatformAdminRole
  permissionId String
  permission   AdminPermission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model AdminSessionEvent {
  id         String   @id @default(cuid())
  userId     String
  type       String
  requestId  String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model TwoFactorRecoveryCode {
  id           String        @id @default(cuid())
  userId       String
  credentialId String
  codeHash     String        @unique
  usedAt       DateTime?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential   MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([credentialId, usedAt])
}

model RateLimitEvent {
  id          String   @id @default(cuid())
  scope       String
  subjectHash String
  ipAddress   String?
  requestId   String?
  blocked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([scope, createdAt])
  @@index([subjectHash, createdAt])
  @@index([blocked, createdAt])
}

model PlatformAdminInvite {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String
  role           PlatformAdminRole @default(SUPER_ADMIN)
  tokenHash      String            @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime          @default(now())
}

model AdminAccessLog {
  id             String   @id @default(cuid())
  userId         String
  path           String
  method         String
  purpose        String?
  permission     String?
  sensitive      Boolean  @default(false)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([sensitive, createdAt])
}
