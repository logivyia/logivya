model User {
  id                                String                      @id @default(cuid())
  name                              String
  username                          String                      @unique
  email                             String                      @unique
  emailVerifiedAt                   DateTime?
  phone                             String?
  passwordHash                      String
  avatarUrl                         String?
  locale                            String                      @default("en")
  timezone                          String                      @default("Europe/Istanbul")
  country                           String                      @default("TR")
  theme                             String                      @default("system")
  status                            UserStatus                  @default(ACTIVE)
  mfaRequired                       Boolean                     @default(false)
  mfaRequiredAt                     DateTime?
  ownedCompanies                    Company[]                   @relation("CompanyOwner")
  memberships                       CompanyUser[]
  campaigns                         MessageCampaign[]
  mediaFiles                        MediaFile[]
  notifications                     Notification[]
  notificationEvents                NotificationEvent[]         @relation("NotificationEventActor")
  notificationPreferences           NotificationPreference[]
  notificationDeliveries            NotificationDelivery[]
  notificationOutbox                NotificationOutbox[]
  notificationDevices               NotificationDevice[]
  notificationDeadLettersResolved   NotificationDeadLetter[]    @relation("NotificationDeadLetterResolver")
  notificationAnnouncementsCreated  NotificationAnnouncement[]  @relation("NotificationAnnouncementCreator")
  notificationAnnouncementsApproved NotificationAnnouncement[]  @relation("NotificationAnnouncementApprover")
  auditLogs                         AuditLog[]
  activities                        Activity[]
  assignedTasks                     Task[]                      @relation("TaskAssignee")
  createdTasks                      Task[]                      @relation("TaskCreator")
  notes                             Note[]
  activityFeed                      ActivityFeedEntry[]
  aiGenerations                     AiGeneration[]
  userMetrics                       UserMetricDaily[]
  loginAttempts                     LoginAttempt[]
  sessions                          UserSession[]
  mobileDeviceSessions              MobileDeviceSession[]
  mobilePushTokens                  MobilePushToken[]
  mobileFeedback                    MobileFeedback[]
  trustedDevices                    TrustedDevice[]
  securityEvents                    SecurityEvent[]
  consents                          ConsentRecord[]
  dataRequests                      DataSubjectRequest[]
  privacyExportJobs                 PrivacyExportJob[]
  privacyDeletionJobs               PrivacyDeletionJob[]
  privacyLegalHolds                 PrivacyLegalHold[]
  passwordResetTokens               PasswordResetToken[]
  emailVerificationTokens           EmailVerificationToken[]
  mfaCredentials                    MfaCredential[]
  mfaLoginChallenges                MfaLoginChallenge[]
  createdSupportTickets             SupportTicket[]             @relation("SupportTicketCreator")
  assignedSupportTickets            SupportTicket[]             @relation("SupportTicketAssignee")
  supportMessages                   SupportTicketMessage[]
  supportTicketAudits               SupportTicketAudit[]        @relation("SupportTicketAuditActor")
  supportNotificationOutbox         SupportNotificationOutbox[] @relation("SupportNotificationRecipient")
  referralCodes                     ReferralCode[]
  referredSignups                   ReferralSignup[]            @relation("ReferredUser")
  emailDeliveries                   EmailDeliveryLog[]
  messageVisibilityRecords          UserMessageVisibility[]
  whatsAppAccounts                  WhatsAppAccount[]
  whatsAppGroups                    WhatsAppGroup[]
  contacts                          Contact[]
  contactSyncRuns                   ContactSyncRun[]
  categoryContactAssignments        CategoryContact[]
  sentCompanyInvitations            CompanyInvitation[]         @relation("CompanyInvitationInviter")
  acceptedCompanyInvitations        CompanyInvitation[]         @relation("CompanyInvitationAcceptedUser")
  trialEntitlements                 TrialEntitlement[]
  subscriptionAuditLogs             SubscriptionAuditLog[]      @relation("SubscriptionAuditActor")
  platformAdmin                     PlatformAdmin?
  adminAccessLogs                   AdminAccessLog[]
  adminSessionEvents                AdminSessionEvent[]
  twoFactorRecoveryCodes            TwoFactorRecoveryCode[]
  manuallyActivatedSubscriptions    Subscription[]              @relation("ManualSubscriptionActivator")
  subscriptionEvents                SubscriptionEvent[]
  createdAt                         DateTime                    @default(now())
  updatedAt                         DateTime                    @updatedAt
}

model Company {
  id                             String                          @id @default(cuid())
  name                           String
  address                        String?
  city                           String?
  district                       String?
  postalCode                     String?
  taxOffice                      String?
  taxNumber                      String?
  phone                          String?
  email                          String?
  ownerId                        String
  owner                          User                            @relation("CompanyOwner", fields: [ownerId], references: [id])
  members                        CompanyUser[]
  invitations                    CompanyInvitation[]
  trialEntitlements              TrialEntitlement[]
  subscriptionAuditLogs          SubscriptionAuditLog[]
  subscriptions                  Subscription[]
  accounts                       WhatsAppAccount[]
  groups                         WhatsAppGroup[]
  contacts                       Contact[]
  contactSyncRuns                ContactSyncRun[]
  categoryContactAssignments     CategoryContact[]
  categories                     Category[]
  campaigns                      MessageCampaign[]
  mediaFiles                     MediaFile[]
  notifications                  Notification[]
  notificationEvents             NotificationEvent[]
  notificationPreferences        NotificationPreference[]
  notificationDeliveries         NotificationDelivery[]
  notificationOutbox             NotificationOutbox[]
  notificationDevices            NotificationDevice[]
  notificationAudienceExpansions NotificationAudienceExpansion[]
  notificationAnnouncements      NotificationAnnouncement[]
  auditLogs                      AuditLog[]
  channels                       Channel[]
  channelAccounts                ChannelAccount[]
  channelMessages                ChannelMessage[]
  aiConfigurations               AiProviderConfiguration[]
  aiGenerations                  AiGeneration[]
  leads                          Lead[]
  customers                      Customer[]
  deals                          Deal[]
  pipelines                      Pipeline[]
  activities                     Activity[]
  tasks                          Task[]
  tags                           Tag[]
  notes                          Note[]
  campaignMetrics                CampaignMetric[]
  accountMetrics                 AccountMetricDaily[]
  categoryMetrics                CategoryMetricDaily[]
  userMetrics                    UserMetricDaily[]
  webhooks                       WebhookEndpoint[]
  webhookEvents                  WebhookEvent[]
  apiKeys                        ApiKey[]
  invoices                       Invoice[]
  payments                       Payment[]
  subscriptionEvents             SubscriptionEvent[]
  coupons                        Coupon[]
  activityFeed                   ActivityFeedEntry[]
  billingProfile                 CompanyBillingProfile?
  securityEvents                 SecurityEvent[]
  consents                       ConsentRecord[]
  dataRequests                   DataSubjectRequest[]
  privacyExportJobs              PrivacyExportJob[]
  privacyDeletionJobs            PrivacyDeletionJob[]
  privacyLegalHolds              PrivacyLegalHold[]
  idempotencyKeys                IdempotencyKey[]
  apiUsageLogs                   ApiUsageLog[]
  incidentLogs                   IncidentLog[]
  supportTickets                 SupportTicket[]
  supportNotificationOutbox      SupportNotificationOutbox[]
  internalNotes                  CompanyInternalNote[]
  onboarding                     OnboardingChecklist?
  branding                       BrandingSettings?
  referralCodes                  ReferralCode[]
  referredSignups                ReferralSignup[]                @relation("ReferredCompany")
  emailDeliveries                EmailDeliveryLog[]
  mobileDeviceSessions           MobileDeviceSession[]
  mobilePushTokens               MobilePushToken[]
  mobileFeedback                 MobileFeedback[]
  securityStatus                 CompanySecurityStatus           @default(ACTIVE)
  billingLockedAt                DateTime?
  campaignsPausedAt              DateTime?
  retentionDays                  Int                             @default(90)
  defaultLanguage                String                          @default("tr")
  defaultTimezone                String                          @default("Europe/Istanbul")
  defaultCurrency                String                          @default("TRY")
  defaultCountry                 String                          @default("TR")
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt

  @@index([ownerId])
}

model CompanyUser {
  id                  String                  @id @default(cuid())
  companyId           String
  userId              String
  role                CompanyRole             @default(OPERATOR)
  status              MembershipStatus        @default(ACTIVE)
  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt            DateTime                @default(now())
  seatActivatedAt     DateTime?               @default(now())
  suspendedAt         DateTime?
  removedAt           DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  permissionOverrides CompanyUserPermission[]

  @@unique([companyId, userId])
  @@index([userId])
}

model CompanyInvitation {
  id               String                     @id @default(cuid())
  companyId        String
  invitedByUserId  String
  acceptedByUserId String?
  email            String
  name             String
  role             CompanyRole                @default(OPERATOR)
  status           CompanyInvitationStatus    @default(PENDING)
  tokenHash        String                     @unique
  shortCodeHash    String?                    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  declinedAt       DateTime?
  revokedAt        DateTime?
  reservedSeat     Boolean                    @default(true)
  sentAt           DateTime?
  resendCount      Int                        @default(0)
  lastResentAt     DateTime?
  company          Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy        User                       @relation("CompanyInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?                      @relation("CompanyInvitationAcceptedUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  deliveries       InvitationDeliveryOutbox[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([companyId, status, expiresAt])
  @@index([email, status])
  @@index([invitedByUserId])
  @@index([acceptedByUserId])
}

model InvitationDeliveryOutbox {
  id             String                   @id @default(cuid())
  eventKey       String                   @unique
  invitationId   String
  recipient      String
  appBaseUrl     String
  tokenEncrypted String?
  locale         String                   @default("tr")
  status         InvitationDeliveryStatus @default(PENDING)
  attempts       Int                      @default(0)
  availableAt    DateTime                 @default(now())
  deliveredAt    DateTime?
  lastError      String?
  invitation     CompanyInvitation        @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status, availableAt])
  @@index([invitationId, createdAt])
}

model Plan {
  id                       String           @id @default(cuid())
  name                     String
  slug                     String           @unique
  description              String?
  monthlyPrice             Decimal          @default(0) @db.Decimal(12, 2)
  yearlyPrice              Decimal          @default(0) @db.Decimal(12, 2)
  currency                 String           @default("TRY")
  trialDays                Int              @default(0)
  maxWhatsappAccounts      Int
  maxTeamUsers             Int              @default(1)
  maxGroups                Int
  maxMessagesPerDay        Int
  maxMessagesPerMonth      Int
  groupMessagingEnabled    Boolean          @default(true)
  contactMessagingEnabled  Boolean          @default(false)
  deleteForEveryoneEnabled Boolean          @default(true)
  advertisingEnabled       Boolean          @default(false)
  hasScheduledMessages     Boolean          @default(false)
  hasRecurringMessages     Boolean          @default(false)
  advancedReportingEnabled Boolean          @default(false)
  hasNoBranding            Boolean          @default(false)
  hasCrm                   Boolean          @default(false)
  hasApi                   Boolean          @default(false)
  isPopular                Boolean          @default(false)
  isCustom                 Boolean          @default(false)
  isActive                 Boolean          @default(true)
  subscriptions            Subscription[]
  payments                 Payment[]
  permissions              PlanPermission[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @default(now()) @updatedAt
}

model Subscription {
  id                        String                 @id @default(cuid())
  companyId                 String
  planId                    String
  status                    SubscriptionStatus     @default(TRIALING)
  billingPeriod             BillingPeriod          @default(TRIAL)
  startsAt                  DateTime?
  endsAt                    DateTime?
  trialStartsAt             DateTime?
  trialEndsAt               DateTime?
  currentPeriodStartsAt     DateTime?
  currentPeriodEndsAt       DateTime?
  cancelAtPeriodEnd         Boolean                @default(false)
  cancelledAt               DateTime?
  expiredAt                 DateTime?
  pastDueAt                 DateTime?
  manuallyActivatedByUserId String?
  source                    SubscriptionSource     @default(TRIAL)
  provider                  BillingProvider        @default(MANUAL)
  providerSubscriptionId    String?
  company                   Company                @relation(fields: [companyId], references: [id])
  plan                      Plan                   @relation(fields: [planId], references: [id])
  manuallyActivatedBy       User?                  @relation("ManualSubscriptionActivator", fields: [manuallyActivatedByUserId], references: [id])
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @default(now()) @updatedAt
  invoices                  Invoice[]
  payments                  Payment[]
  events                    SubscriptionEvent[]
  auditLogs                 SubscriptionAuditLog[]
  appliedCoupons            SubscriptionCoupon[]

  @@index([companyId, status])
  @@index([status, currentPeriodEndsAt])
}

model SubscriptionAuditLog {
  id             String        @id @default(cuid())
  companyId      String
  subscriptionId String?
  actorUserId    String?
  eventType      String
  previousState  Json?
  newState       Json?
  correlationId  String?
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  actorUser      User?         @relation("SubscriptionAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([companyId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([eventType, createdAt])
}

model BillingWebhookReceipt {
  id                String          @id @default(cuid())
  provider          BillingProvider
  eventId           String
  eventType         String
  providerPaymentId String?
  payloadHash       String
  status            String          @default("RECEIVED")
  attempts          Int             @default(1)
  lastError         String?
  processedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@index([providerPaymentId, createdAt])
}

model TrialEntitlement {
  id                    String                 @id @default(cuid())
  companyId             String
  userId                String
  whatsappAccountId     String?                @unique
  status                TrialEntitlementStatus @default(PENDING_IDENTITY)
  phoneEncrypted        String?
  phoneHash             String?
  whatsappIdentityHash  String?
  registrationPhoneHash String?
  registrationIpHash    String?
  deviceFingerprintHash String?
  riskScore             Int                    @default(0)
  riskSignals           Json?
  decisionCode          String?
  startedAt             DateTime?
  endsAt                DateTime?
  consumedAt            DateTime?
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  whatsappAccount       WhatsAppAccount?       @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([companyId, userId])
  @@index([phoneHash, status])
  @@index([whatsappIdentityHash, status])
  @@index([registrationPhoneHash, status])
  @@index([registrationIpHash, status])
  @@index([deviceFingerprintHash, status])
  @@index([status, createdAt])
}

model WhatsAppAccount {
  id                         String             @id @default(cuid())
  userId                     String?
  companyId                  String
  label                      String?
  phoneNumber                String?
  displayName                String?
  provider                   String
  providerSessionId          String?
  status                     AccountStatus      @default(PENDING_QR)
  lastConnectedAt            DateTime?
  lastDisconnectedAt         DateTime?
  lastSyncedAt               DateTime?
  lastHeartbeatAt            DateTime?
  lastPingAt                 DateTime?
  lastPongAt                 DateTime?
  lastMessageAt              DateTime?
  lastGroupSyncAt            DateTime?
  lastContactSyncAt          DateTime?
  contactSyncImplementation  String?
  lastConnectionLatencyMs    Int?
  batteryState               String?
  healthScore                Int                @default(0)
  recoveryLevel              Int                @default(0)
  sessionRestoredAt          DateTime?
  sessionSnapshotAt          DateTime?
  reconnectRetryCount        Int                @default(0)
  deviceId                   String?
  syncIntervalMinutes        Int                @default(120)
  archivedAt                 DateTime?
  lastError                  String?
  qrCode                     String?
  qrExpiresAt                DateTime?
  pairingCode                String?
  pairingCodeExpiresAt       DateTime?
  user                       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  company                    Company            @relation(fields: [companyId], references: [id])
  sessions                   WhatsAppSession[]
  groups                     WhatsAppGroup[]
  contacts                   Contact[]
  contactSyncRuns            ContactSyncRun[]
  categoryContactAssignments CategoryContact[]
  recipients                 MessageRecipient[]
  trialEntitlement           TrialEntitlement?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([userId])
  @@index([companyId, status])
  @@index([userId, companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, archivedAt])
  @@index([userId, archivedAt])
}

model WhatsAppSession {
