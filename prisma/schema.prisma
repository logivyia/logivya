generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CompanyRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  SUSPENDED
  PAST_DUE
  CANCELED
  EXPIRED
  MANUAL_PENDING
  PAYMENT_PENDING
}

enum BillingPeriod {
  TRIAL
  MONTHLY
  YEARLY
  CUSTOM
}

enum SubscriptionSource {
  TRIAL
  MANUAL_ADMIN
  PAYMENT_PROVIDER
}

enum AccountStatus {
  CREATED
  NEW
  PENDING_QR
  PENDING_PAIRING
  QR_READY
  PAIRING_CODE_READY
  CONNECTING
  CONNECTED
  DISCONNECTED
  RECONNECT_REQUIRED
  ARCHIVED
  FAILED
  ERROR
}

enum CampaignType {
  WHATSAPP_GROUP
  WHATSAPP_CONTACT
}

enum ScheduleType {
  SEND_NOW
  SCHEDULED
  RECURRING
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELING
  CANCELED
  DELETING
  DELETED
}

enum RecipientStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELED
  SKIPPED
}

enum ChannelType {
  WHATSAPP
  TELEGRAM
  FACEBOOK_GROUP
  FACEBOOK_PAGE
  INSTAGRAM
  SMS
  EMAIL
  API
}

enum ChannelAccountStatus {
  PENDING
  CONNECTING
  CONNECTED
  DISCONNECTED
  RECONNECT_REQUIRED
  ARCHIVED
  ERROR
}

enum ChannelMessageDirection {
  INBOUND
  OUTBOUND
}

enum ChannelMessageStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELED
}

enum AiProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE_GEMINI
  LOCAL
}

enum AiGenerationType {
  REWRITE
  IMPROVE
  TRANSLATE
  LOGISTICS_ANNOUNCEMENT
  TRANSPORTATION_OFFER
  CUSTOMER_CAMPAIGN
  MARKETING_MESSAGE
  SALES_MESSAGE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  MESSAGE
  EMAIL
  MEETING
  NOTE
  SYSTEM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SafetyRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERING
  DELIVERED
  FAILED
  DEAD_LETTER
}

enum BillingProvider {
  STRIPE
  PADDLE
  IYZICO
  PAYTR
  MANUAL
  PARASUT
  LOGO
  MIKRO
}

enum BillingType {
  INDIVIDUAL
  COMPANY
}

enum InvoiceType {
  E_INVOICE
  E_ARCHIVE
  STANDARD_INVOICE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELED
  FAILED
}

enum InvoiceProviderType {
  MANUAL
  PARASUT
  LOGO
  MIKRO
  NEBIM
  IYZICO
  PAYTR
  STRIPE
  PADDLE
}

enum PaymentStatus {
  PENDING
  MANUALLY_CONFIRMED
  REJECTED
  SUCCEEDED
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentMethod {
  MANUAL_BANK_TRANSFER
  MANUAL
  FREE_PROMO
  CREDIT_CARD
  DEBIT_CARD
  CASH
  OTHER
}

enum SubscriptionEventType {
  TRIAL_STARTED
  TRIAL_EXPIRED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_MANUALLY_ACTIVATED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_REACTIVATED
  SUBSCRIPTION_EXPIRED
  PLAN_CHANGED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  INVOICE_CREATED
}

enum SecurityEventSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataRequestType {
  ACCESS
  EXPORT
  RECTIFICATION
  DELETION
}

enum DataRequestStatus {
  REQUESTED
  VERIFYING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELED
}

enum ConsentType {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  KVKK
  MARKETING
}

enum SupportTicketStatus {
  OPEN
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportSenderType {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum ReferralSignupStatus {
  PENDING
  QUALIFIED
  CONVERTED
  REJECTED
}

enum AnnouncementType {
  INFO
  WARNING
  MAINTENANCE
  FEATURE
}

enum PlatformAdminRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SECURITY_ADMIN
  COMPLIANCE_ADMIN
  BILLING_ADMIN
  SUPPORT_ADMIN
  OPERATIONS_ADMIN
  READ_ONLY_ADMIN
}

enum CompanySecurityStatus {
  ACTIVE
  DISABLED
  UNDER_INVESTIGATION
}

model User {
  id                             String                   @id @default(cuid())
  name                           String
  username                       String                   @unique
  email                          String                   @unique
  phone                          String?
  passwordHash                   String
  avatarUrl                      String?
  locale                         String                   @default("en")
  timezone                       String                   @default("Europe/Istanbul")
  country                        String                   @default("TR")
  theme                          String                   @default("system")
  status                         UserStatus               @default(ACTIVE)
  ownedCompanies                 Company[]                @relation("CompanyOwner")
  memberships                    CompanyUser[]
  campaigns                      MessageCampaign[]
  mediaFiles                     MediaFile[]
  notifications                  Notification[]
  auditLogs                      AuditLog[]
  activities                     Activity[]
  assignedTasks                  Task[]                   @relation("TaskAssignee")
  createdTasks                   Task[]                   @relation("TaskCreator")
  notes                          Note[]
  activityFeed                   ActivityFeedEntry[]
  aiGenerations                  AiGeneration[]
  userMetrics                    UserMetricDaily[]
  loginAttempts                  LoginAttempt[]
  sessions                       UserSession[]
  trustedDevices                 TrustedDevice[]
  securityEvents                 SecurityEvent[]
  consents                       ConsentRecord[]
  dataRequests                   DataSubjectRequest[]
  passwordResetTokens            PasswordResetToken[]
  emailVerificationTokens        EmailVerificationToken[]
  mfaCredentials                 MfaCredential[]
  createdSupportTickets          SupportTicket[]          @relation("SupportTicketCreator")
  assignedSupportTickets         SupportTicket[]          @relation("SupportTicketAssignee")
  supportMessages                SupportTicketMessage[]
  referralCodes                  ReferralCode[]
  referredSignups                ReferralSignup[]          @relation("ReferredUser")
  emailDeliveries                EmailDeliveryLog[]
  platformAdmin                  PlatformAdmin?
  adminAccessLogs                AdminAccessLog[]
  adminSessionEvents             AdminSessionEvent[]
  twoFactorRecoveryCodes         TwoFactorRecoveryCode[]
  manuallyActivatedSubscriptions Subscription[]           @relation("ManualSubscriptionActivator")
  subscriptionEvents             SubscriptionEvent[]
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
}

model Company {
  id                 String                    @id @default(cuid())
  name               String
  address            String?
  taxOffice          String?
  taxNumber          String?
  phone              String?
  email              String?
  ownerId            String
  owner              User                      @relation("CompanyOwner", fields: [ownerId], references: [id])
  members            CompanyUser[]
  subscriptions      Subscription[]
  accounts           WhatsAppAccount[]
  groups             WhatsAppGroup[]
  contacts           Contact[]
  categories         Category[]
  campaigns          MessageCampaign[]
  mediaFiles         MediaFile[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  channels           Channel[]
  channelAccounts    ChannelAccount[]
  channelMessages    ChannelMessage[]
  aiConfigurations   AiProviderConfiguration[]
  aiGenerations      AiGeneration[]
  leads              Lead[]
  customers          Customer[]
  deals              Deal[]
  pipelines          Pipeline[]
  activities         Activity[]
  tasks              Task[]
  tags               Tag[]
  notes              Note[]
  campaignMetrics    CampaignMetric[]
  accountMetrics     AccountMetricDaily[]
  categoryMetrics    CategoryMetricDaily[]
  userMetrics        UserMetricDaily[]
  webhooks           WebhookEndpoint[]
  webhookEvents      WebhookEvent[]
  apiKeys            ApiKey[]
  invoices           Invoice[]
  payments           Payment[]
  subscriptionEvents SubscriptionEvent[]
  coupons            Coupon[]
  activityFeed       ActivityFeedEntry[]
  billingProfile     CompanyBillingProfile?
  securityEvents     SecurityEvent[]
  dataRequests       DataSubjectRequest[]
  idempotencyKeys    IdempotencyKey[]
  apiUsageLogs       ApiUsageLog[]
  incidentLogs       IncidentLog[]
  supportTickets     SupportTicket[]
  internalNotes      CompanyInternalNote[]
  onboarding         OnboardingChecklist?
  branding           BrandingSettings?
  referralCodes      ReferralCode[]
  referredSignups    ReferralSignup[]            @relation("ReferredCompany")
  emailDeliveries    EmailDeliveryLog[]
  securityStatus     CompanySecurityStatus     @default(ACTIVE)
  billingLockedAt    DateTime?
  campaignsPausedAt  DateTime?
  retentionDays      Int                       @default(90)
  defaultLanguage    String                    @default("tr")
  defaultTimezone    String                    @default("Europe/Istanbul")
  defaultCurrency    String                    @default("TRY")
  defaultCountry     String                    @default("TR")
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([ownerId])
}

model CompanyUser {
  id                  String                  @id @default(cuid())
  companyId           String
  userId              String
  role                CompanyRole             @default(OPERATOR)
  status              MembershipStatus        @default(ACTIVE)
  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime                @default(now())
  permissionOverrides CompanyUserPermission[]

  @@unique([companyId, userId])
  @@index([userId])
}

model Plan {
  id                       String           @id @default(cuid())
  name                     String
  slug                     String           @unique
  description              String?
  monthlyPrice             Decimal          @default(0) @db.Decimal(12, 2)
  yearlyPrice              Decimal          @default(0) @db.Decimal(12, 2)
  currency                 String           @default("TRY")
  trialDays                Int              @default(0)
  maxWhatsappAccounts      Int
  maxTeamUsers             Int              @default(1)
  maxGroups                Int
  maxMessagesPerDay        Int
  maxMessagesPerMonth      Int
  advertisingEnabled       Boolean          @default(false)
  hasScheduledMessages     Boolean          @default(false)
  hasRecurringMessages     Boolean          @default(false)
  advancedReportingEnabled Boolean          @default(false)
  hasNoBranding            Boolean          @default(false)
  hasCrm                   Boolean          @default(false)
  hasApi                   Boolean          @default(false)
  isPopular                Boolean          @default(false)
  isCustom                 Boolean          @default(false)
  isActive                 Boolean          @default(true)
  subscriptions            Subscription[]
  payments                 Payment[]
  permissions              PlanPermission[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @default(now()) @updatedAt
}

model Subscription {
  id                        String               @id @default(cuid())
  companyId                 String
  planId                    String
  status                    SubscriptionStatus   @default(TRIALING)
  billingPeriod             BillingPeriod        @default(TRIAL)
  startsAt                  DateTime?
  endsAt                    DateTime?
  trialStartsAt             DateTime?
  trialEndsAt               DateTime?
  currentPeriodStartsAt     DateTime?
  currentPeriodEndsAt       DateTime?
  cancelAtPeriodEnd         Boolean              @default(false)
  cancelledAt               DateTime?
  expiredAt                 DateTime?
  pastDueAt                 DateTime?
  manuallyActivatedByUserId String?
  source                    SubscriptionSource   @default(TRIAL)
  provider                  BillingProvider      @default(MANUAL)
  providerSubscriptionId    String?
  company                   Company              @relation(fields: [companyId], references: [id])
  plan                      Plan                 @relation(fields: [planId], references: [id])
  manuallyActivatedBy       User?                @relation("ManualSubscriptionActivator", fields: [manuallyActivatedByUserId], references: [id])
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @default(now()) @updatedAt
  invoices                  Invoice[]
  payments                  Payment[]
  events                    SubscriptionEvent[]
  appliedCoupons            SubscriptionCoupon[]

  @@index([companyId, status])
  @@index([status, currentPeriodEndsAt])
}

model WhatsAppAccount {
  id                  String             @id @default(cuid())
  companyId           String
  label               String?
  phoneNumber         String?
  displayName         String?
  provider            String
  providerSessionId   String?
  status              AccountStatus      @default(PENDING_QR)
  lastConnectedAt     DateTime?
  lastDisconnectedAt  DateTime?
  lastSyncedAt        DateTime?
  syncIntervalMinutes Int                @default(120)
  archivedAt          DateTime?
  lastError           String?
  qrCode              String?
  qrExpiresAt         DateTime?
  pairingCode         String?
  pairingCodeExpiresAt DateTime?
  company             Company            @relation(fields: [companyId], references: [id])
  sessions            WhatsAppSession[]
  groups              WhatsAppGroup[]
  contacts            Contact[]
  recipients          MessageRecipient[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, archivedAt])
}

model WhatsAppSession {
  id                   String          @id @default(cuid())
  accountId            String
  qrCode               String?
  status               AccountStatus
  sessionDataEncrypted String?
  expiresAt            DateTime?
  account              WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([accountId, status])
}

model WhatsAppGroup {
  id               String             @id @default(cuid())
  companyId        String
  accountId        String
  externalGroupId  String
  name             String
  description      String?
  participantCount Int                @default(0)
  canSend          Boolean            @default(true)
  isArchived       Boolean            @default(false)
  lastSyncedAt     DateTime
  company          Company            @relation(fields: [companyId], references: [id])
  account          WhatsAppAccount    @relation(fields: [accountId], references: [id])
  categories       CategoryGroup[]
  recipients       MessageRecipient[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([accountId, externalGroupId])
  @@index([companyId, isArchived])
}

model Contact {
  id                String             @id @default(cuid())
  companyId         String
  accountId         String
  externalContactId String
  name              String?
  phone             String
  source            String?
  company           Company            @relation(fields: [companyId], references: [id])
  account           WhatsAppAccount    @relation(fields: [accountId], references: [id])
  recipients        MessageRecipient[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([accountId, externalContactId])
  @@index([companyId, phone])
}

model Category {
  id          String                @id @default(cuid())
  companyId   String
  name        String
  color       String
  description String?
  archivedAt  DateTime?
  company     Company               @relation(fields: [companyId], references: [id])
  groups      CategoryGroup[]
  metrics     CategoryMetricDaily[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([companyId, name])
  @@index([companyId, archivedAt])
  @@index([companyId, createdAt])
}

model CategoryGroup {
  id         String        @id @default(cuid())
  categoryId String
  groupId    String
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group      WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([categoryId, groupId])
  @@index([groupId, categoryId])
}

model MessageCampaign {
  id              String             @id @default(cuid())
  companyId       String
  createdById     String
  title           String
  content         String
  contentJson     Json?
  type            CampaignType
  status          CampaignStatus     @default(DRAFT)
  scheduleType    ScheduleType       @default(SEND_NOW)
  scheduledAt     DateTime?
  recurringRule   Json?
  totalRecipients Int                @default(0)
  sentCount       Int                @default(0)
  failedCount     Int                @default(0)
  canceledCount   Int                @default(0)
  deletedAt       DateTime?
  company         Company            @relation(fields: [companyId], references: [id])
  createdBy       User               @relation(fields: [createdById], references: [id])
  recipients      MessageRecipient[]
  channelMessages ChannelMessage[]
  metric          CampaignMetric?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([companyId, status, createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, deletedAt])
}

model MessageRecipient {
  id                  String          @id @default(cuid())
  campaignId          String
  accountId           String
  groupId             String?
  contactId           String?
  recipientName       String
  recipientExternalId String
  status              RecipientStatus @default(PENDING)
  errorMessage        String?
  sentAt              DateTime?
  failedAt            DateTime?
  campaign            MessageCampaign @relation(fields: [campaignId], references: [id])
  account             WhatsAppAccount @relation(fields: [accountId], references: [id])
  group               WhatsAppGroup?  @relation(fields: [groupId], references: [id])
  contact             Contact?        @relation(fields: [contactId], references: [id])
  createdAt           DateTime        @default(now())

  @@index([campaignId, status])
  @@index([accountId, status])
}

model MediaFile {
  id           String   @id @default(cuid())
  companyId    String
  uploadedById String
  fileName     String
  mimeType     String
  size         Int
  storageKey   String
  publicUrl    String?
  company      Company  @relation(fields: [companyId], references: [id])
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([companyId])
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  company   Company  @relation(fields: [companyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  company    Company  @relation(fields: [companyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
}

// Generic communication core. WhatsApp-specific models remain as an MVP adapter
// until live sessions are migrated into this provider-neutral layer.
model Channel {
  id        String           @id @default(cuid())
  companyId String
  type      ChannelType
  name      String
  isEnabled Boolean          @default(true)
  settings  Json?
  company   Company          @relation(fields: [companyId], references: [id])
  accounts  ChannelAccount[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([companyId, type, name])
  @@index([companyId, type, isEnabled])
}

model ChannelAccount {
  id                   String                @id @default(cuid())
  companyId            String
  channelId            String
  label                String
  externalAccountId    String?
  displayName          String?
  provider             String
  status               ChannelAccountStatus  @default(PENDING)
  credentialsEncrypted String?
  settings             Json?
  lastConnectedAt      DateTime?
  lastDisconnectedAt   DateTime?
  lastSyncedAt         DateTime?
  archivedAt           DateTime?
  company              Company               @relation(fields: [companyId], references: [id])
  channel              Channel               @relation(fields: [channelId], references: [id])
  sessions             ChannelSession[]
  messages             ChannelMessage[]
  safetyProfile        AccountSafetyProfile?
  accountMetrics       AccountMetricDaily[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([channelId, externalAccountId])
  @@index([companyId, status])
}

model ChannelSession {
  id                   String               @id @default(cuid())
  channelAccountId     String
  externalSessionId    String?
  status               ChannelAccountStatus
  sessionDataEncrypted String?
  expiresAt            DateTime?
  lastHeartbeatAt      DateTime?
  channelAccount       ChannelAccount       @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([channelAccountId, status])
}

model ChannelMessage {
  id                  String                  @id @default(cuid())
  companyId           String
  channelAccountId    String
  campaignId          String?
  externalMessageId   String?
  externalThreadId    String?
  recipientExternalId String
  direction           ChannelMessageDirection
  status              ChannelMessageStatus    @default(PENDING)
  content             String?
  contentJson         Json?
  errorCode           String?
  errorMessage        String?
  queuedAt            DateTime?
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  failedAt            DateTime?
  company             Company                 @relation(fields: [companyId], references: [id])
  channelAccount      ChannelAccount          @relation(fields: [channelAccountId], references: [id])
  campaign            MessageCampaign?        @relation(fields: [campaignId], references: [id])
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([companyId, createdAt])
  @@index([channelAccountId, status])
  @@index([campaignId, status])
}

model AiProviderConfiguration {
  id                   String         @id @default(cuid())
  companyId            String
  provider             AiProviderType
  label                String
  model                String
  credentialsEncrypted String?
  baseUrl              String?
  settings             Json?
  isDefault            Boolean        @default(false)
  isActive             Boolean        @default(true)
  company              Company        @relation(fields: [companyId], references: [id])
  generations          AiGeneration[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([companyId, label])
  @@index([companyId, provider, isActive])
}

model AiGeneration {
  id              String                   @id @default(cuid())
  companyId       String
  userId          String
  configurationId String?
  type            AiGenerationType
  input           Json
  output          Json?
  model           String?
  inputTokens     Int?
  outputTokens    Int?
  latencyMs       Int?
  errorMessage    String?
  company         Company                  @relation(fields: [companyId], references: [id])
  user            User                     @relation(fields: [userId], references: [id])
  configuration   AiProviderConfiguration? @relation(fields: [configurationId], references: [id])
  createdAt       DateTime                 @default(now())

  @@index([companyId, type, createdAt])
}

model Lead {
  id                  String     @id @default(cuid())
  companyId           String
  name                String
  email               String?
  phone               String?
  companyName         String?
  source              String?
  status              LeadStatus @default(NEW)
  metadata            Json?
  convertedCustomerId String?
  company             Company    @relation(fields: [companyId], references: [id])
  convertedCustomer   Customer?  @relation(fields: [convertedCustomerId], references: [id])
  activities          Activity[]
  notes               Note[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([companyId, status, createdAt])
}

model Customer {
  id             String        @id @default(cuid())
  companyId      String
  name           String
  email          String?
  phone          String?
  companyName    String?
  metadata       Json?
  company        Company       @relation(fields: [companyId], references: [id])
  convertedLeads Lead[]
  deals          Deal[]
  activities     Activity[]
  notes          Note[]
  tags           CustomerTag[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId, name])
  @@index([companyId, phone])
}

model Pipeline {
  id        String          @id @default(cuid())
  companyId String
  name      String
  isDefault Boolean         @default(false)
  company   Company         @relation(fields: [companyId], references: [id])
  stages    PipelineStage[]
  deals     Deal[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([companyId, name])
}

model PipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  position    Int
  probability Int      @default(0)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]

