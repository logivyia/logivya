  sourceCount       Int                         @default(1)
  matchedAt         DateTime                    @default(now())
  notifiedAt        DateTime?
  viewedAt          DateTime?
  savedAt           DateTime?
  dismissedAt       DateTime?
  expiredAt         DateTime?
  demand            MarketplaceDemandRequest    @relation(fields: [demandId], references: [id], onDelete: Cascade)
  candidate         FreightOpportunityCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company           Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner             User                        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([demandId, candidateId])
  @@index([demandId, status, score, matchedAt], map: "SmartMatchResult_demand_status_score_matched_idx")
  @@index([ownerUserId, status, matchedAt], map: "SmartMatchResult_owner_status_matched_idx")
  @@index([duplicateGroupKey, demandId], map: "SmartMatchResult_duplicate_demand_idx")
  @@index([notifiedAt, createdAt], map: "SmartMatchResult_notified_created_idx")
}

model MarketplaceDemandMatch {
  id                  String                   @id @default(cuid())
  requestId           String
  listingKind         MarketplaceRequestKind
  listingId           String
  listingOwnerUserId  String
  score               Int
  reasons             String[]                 @default([])
  status              MarketplaceMatchStatus   @default(NEW)
  notificationEventId String?
  matchedAt           DateTime                 @default(now())
  notifiedAt          DateTime?
  viewedAt            DateTime?
  dismissedAt         DateTime?
  request             MarketplaceDemandRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  listingOwner        User                     @relation("MarketplaceMatchListingOwner", fields: [listingOwnerUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([requestId, listingKind, listingId])
  @@index([requestId, status, matchedAt])
  @@index([listingKind, listingId])
  @@index([notificationEventId])
  @@index([notifiedAt, createdAt])
}

// Telegram is isolated from the stable WhatsApp delivery core. TDLib owns the
// encrypted local session database; only its encrypted database key and safe
// account metadata are stored here.
model TelegramAccount {
  id                   String                @id @default(cuid())
  channelAccountId     String                @unique
  companyId            String
  ownerUserId          String
  storageKey           String                @unique
  label                String
  accountType          TelegramAccountType   @default(USER)
  phoneNumberMasked    String?
  telegramUserId       String?
  username             String?
  firstName            String?
  lastName             String?
  status               TelegramAccountStatus @default(PENDING_AUTH)
  authState            TelegramAuthState     @default(STARTING)
  authStateDetail      Json?
  databaseKeyEncrypted String
  lastConnectedAt      DateTime?
  lastDisconnectedAt   DateTime?
  lastSyncedAt         DateTime?
  lastErrorCode        String?
  lastErrorMessage     String?
  archivedAt           DateTime?
  channelAccount       ChannelAccount        @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  owner                User                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  chats                TelegramChat[]
  dispatches           TelegramDispatch[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([ownerUserId, telegramUserId])
  @@index([companyId, ownerUserId, status])
  @@index([ownerUserId, archivedAt])
}

model TelegramChat {
  id                  String                   @id @default(cuid())
  companyId           String
  accountId           String
  externalChatId      String
  title               String
  username            String?
  type                TelegramChatType
  participantCount    Int                      @default(0)
  canSend             Boolean                  @default(false)
  isActive            Boolean                  @default(true)
  isArchived          Boolean                  @default(false)
  rawPermissions      Json?
  lastSyncedAt        DateTime
  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  account             TelegramAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryAssignments TelegramCategoryChat[]
  dispatchTargets     TelegramDispatchTarget[]
  deliveries          TelegramDelivery[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([accountId, externalChatId])
  @@index([companyId, accountId, isActive, canSend])
  @@index([accountId, type, isActive, isArchived])
}

model TelegramCategoryChat {
  id         String       @id @default(cuid())
  categoryId String
  chatId     String
  companyId  String
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  chat       TelegramChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([categoryId, chatId])
  @@index([chatId, categoryId])
  @@index([companyId, categoryId])
}

model TelegramDispatch {
  id                   String                   @id @default(cuid())
  companyId            String
  accountId            String
  createdById          String
  clientRequestId      String
  title                String?
  content              String
  contentJson          Json?
  scheduleType         ScheduleType             @default(SEND_NOW)
  scheduledAt          DateTime?
  timezone             String                   @default("Europe/Istanbul")
  recurringRule        Json?
  nextRunAt            DateTime
  status               TelegramDispatchStatus   @default(ACTIVE)
  deleteRequestedAt    DateTime?
  deletedForEveryoneAt DateTime?
  deleteTotalCount     Int                      @default(0)
  deleteSuccessCount   Int                      @default(0)
  deleteFailedCount    Int                      @default(0)
  company              Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  account              TelegramAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy            User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  targets              TelegramDispatchTarget[]
  runs                 TelegramDispatchRun[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([createdById, clientRequestId])
  @@index([status, nextRunAt])
  @@index([companyId, createdById, createdAt])
  @@index([accountId, status, nextRunAt])
}

model TelegramDispatchTarget {
  id         String           @id @default(cuid())
  dispatchId String
  chatId     String
  dispatch   TelegramDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  chat       TelegramChat     @relation(fields: [chatId], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())

  @@unique([dispatchId, chatId])
  @@index([chatId, dispatchId])
}

model TelegramDispatchRun {
  id              String             @id @default(cuid())
  dispatchId      String
  occurrenceKey   String
  scheduledFor    DateTime
  status          TelegramRunStatus  @default(QUEUED)
  totalRecipients Int                @default(0)
  sentCount       Int                @default(0)
  failedCount     Int                @default(0)
  floodWaitCount  Int                @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  dispatch        TelegramDispatch   @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  deliveries      TelegramDelivery[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([dispatchId, occurrenceKey])
  @@index([status, scheduledFor])
  @@index([dispatchId, createdAt])
}

model TelegramDelivery {
  id                   String                      @id @default(cuid())
  runId                String
  chatId               String
  status               TelegramDeliveryStatus      @default(QUEUED)
  attemptCount         Int                         @default(0)
  nextAttemptAt        DateTime                    @default(now())
  renderedContent      String?
  attributionApplied   Boolean?
  attributionLocale    String?
  attributionVersion   String?
  effectivePlanCode    String?
  renderedAt           DateTime?
  lockedAt             DateTime?
  lockedBy             String?
  externalMessageId    String?
  errorCode            String?
  errorMessage         String?
  sentAt               DateTime?
  deleteStatus         TelegramMessageDeleteStatus @default(NONE)
  deleteRequestedAt    DateTime?
  deletedForEveryoneAt DateTime?
  deleteErrorCode      String?
  run                  TelegramDispatchRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  chat                 TelegramChat                @relation(fields: [chatId], references: [id], onDelete: Restrict)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@unique([runId, chatId])
  @@index([status, nextAttemptAt])
  @@index([chatId, sentAt])
  @@index([lockedBy, lockedAt])
  @@index([deleteStatus, updatedAt])
}

model FeatureFlag {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  description       String?
  isEnabled         Boolean  @default(false)
  rolloutPercentage Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProductFeaturePublication {
  id              String               @id @default(cuid())
  key             String               @unique
  status          ProductFeatureStatus
  platformStatus  Json?
  providerBlocked Boolean              @default(false)
  blockerCode     String?
  note            String?
  updatedById     String?
  effectiveAt     DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, effectiveAt])
  @@index([providerBlocked])
}

model PlatformAdmin {
  id              String            @id @default(cuid())
  userId          String            @unique
  role            PlatformAdminRole
  permissions     String[]
  isActive        Boolean           @default(true)
  requiresMfa     Boolean           @default(true)
  lastElevatedAt  DateTime?
  createdByUserId String?
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([role, isActive])
}

model AdminPermission {
  id          String                @id @default(cuid())
  code        String                @unique
  description String?
  roles       AdminRolePermission[]
  createdAt   DateTime              @default(now())
}

model AdminRolePermission {
  id           String            @id @default(cuid())
  role         PlatformAdminRole
  permissionId String
  permission   AdminPermission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model AdminSessionEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  requestId String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model TwoFactorRecoveryCode {
  id           String        @id @default(cuid())
  userId       String
  credentialId String
  codeHash     String        @unique
  usedAt       DateTime?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential   MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([credentialId, usedAt])
}

model RateLimitEvent {
  id          String   @id @default(cuid())
  scope       String
  subjectHash String
  ipAddress   String?
  requestId   String?
  blocked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([scope, createdAt])
  @@index([subjectHash, createdAt])
  @@index([blocked, createdAt])
}

model PlatformAdminInvite {
  id         String            @id @default(cuid())
  email      String            @unique
  name       String
  role       PlatformAdminRole @default(SUPER_ADMIN)
  tokenHash  String            @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime          @default(now())
}

model AdminAccessLog {
  id         String   @id @default(cuid())
  userId     String
  path       String
  method     String
  purpose    String?
  permission String?
  sensitive  Boolean  @default(false)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([sensitive, createdAt])
}

enum ReleasePlatform {
  ANDROID
  IOS
  WEB
}

enum ReleaseStatus {
  DRAFT
  VALIDATING
  BLOCKED
  APPROVED
  BUILT
  SUBMITTED
  ROLLING_OUT
  COMPLETED
  ROLLED_BACK
}

enum ReleaseCheckStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  FAILED
  WAIVED_WITH_APPROVAL
  NOT_APPLICABLE
}

enum ReleaseArtifactType {
  AAB
  APK
  IPA
  ARCHIVE
  SBOM
  SOURCE_MAP
  RELEASE_MANIFEST
  TEST_REPORT
  SCREENSHOT
  OTHER
}

enum StoreProvider {
  GOOGLE_PLAY
  APP_STORE
}

enum StoreSubmissionStatus {
  NOT_STARTED
  DRAFT
  UPLOADED
  IN_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  REVOKED
}

enum RolloutStatus {
  PLANNED
  ACTIVE
  PAUSED
  HALTED
  COMPLETED
  ROLLED_BACK
}

model Release {
  id                 String            @id @default(cuid())
  releaseId          String            @unique
  platform           ReleasePlatform
  packageId          String
  versionCode        Int?
  versionName        String
  gitCommit          String
  apiContractVersion String?
  buildDate          DateTime?
  channel            String?
  status             ReleaseStatus     @default(DRAFT)
  notes              String?
  artifacts          ReleaseArtifact[]
  checks             ReleaseCheck[]
  submissions        StoreSubmission[]
  tests              TestExecution[]
  approvals          Approval[]
  rolloutStages      RolloutStage[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([platform, packageId, versionCode])
  @@index([platform, status, createdAt])
  @@index([gitCommit])
}

model ReleaseArtifact {
  id                       String              @id @default(cuid())
  releaseId                String
  type                     ReleaseArtifactType
  fileName                 String
  storageUri               String?
  sha256                   String
  sizeBytes                BigInt
  signingCertificateSha256 String?
  metadata                 Json?
  release                  Release             @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdAt                DateTime            @default(now())

  @@unique([releaseId, sha256])
  @@index([releaseId, type])
}

model ReleaseCheck {
  id              String             @id @default(cuid())
  releaseId       String
  key             String
  name            String
  status          ReleaseCheckStatus @default(NOT_STARTED)
  required        Boolean            @default(true)
  evidenceUri     String?
  evidenceSummary String?
  waiverReason    String?
  completedBy     String?
  completedAt     DateTime?
  release         Release            @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([releaseId, key])
  @@index([releaseId, status])
}

model StoreSubmission {
  id          String                @id @default(cuid())
  releaseId   String
  provider    StoreProvider
  track       String
  status      StoreSubmissionStatus @default(NOT_STARTED)
  externalId  String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  notes       String?
  release     Release               @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([releaseId, provider, track])
  @@index([provider, status, createdAt])
}

model TestExecution {
  id          String             @id @default(cuid())
  releaseId   String
  suite       String
  environment String
  device      String?
  status      ReleaseCheckStatus
  reportUri   String?
  summary     String?
  startedAt   DateTime
  completedAt DateTime?
  release     Release            @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())

  @@index([releaseId, status])
  @@index([suite, createdAt])
}

model Approval {
  id         String           @id @default(cuid())
  releaseId  String
  kind       String
  decision   ApprovalDecision
  approvedBy String
  reference  String
  notes      String?
  release    Release          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@index([releaseId, kind, createdAt])
  @@index([decision, createdAt])
}

model RolloutStage {
  id          String        @id @default(cuid())
  releaseId   String
  provider    StoreProvider
  track       String
  percentage  Int
  status      RolloutStatus @default(PLANNED)
  metrics     Json?
  haltReason  String?
  startedAt   DateTime?
  completedAt DateTime?
  release     Release       @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([releaseId, provider, track, percentage])
  @@index([status, createdAt])
}
