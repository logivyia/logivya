{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_BASE_URL": "https://www.logivya.com",
        "EXPO_PUBLIC_APP_VERSION": "1.0.0",
        "ANDROID_VERSION_CODE": "1",
        "IOS_BUILD_NUMBER": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://www.logivya.com",
        "EXPO_PUBLIC_APP_VERSION": "1.0.0",
        "ANDROID_VERSION_CODE": "1",
        "IOS_BUILD_NUMBER": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": false,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://www.logivya.com",
        "EXPO_PUBLIC_APP_VERSION": "1.0.0",
        "ANDROID_VERSION_CODE": "1",
        "IOS_BUILD_NUMBER": "1"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
