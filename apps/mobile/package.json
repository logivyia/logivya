{
  "name": "@logivya/mobile",
  "version": "1.0.210",
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas:login": "npx eas login",
    "eas:whoami": "npx eas whoami",
    "eas:init": "npx eas init",
    "prebuild:android": "expo prebuild --platform android",
    "build:android:local-apk": "cd android && gradlew.bat assembleRelease",
    "build:android:preview": "npx eas build --platform android --profile preview",
    "build:android:production": "npx eas build --platform android --profile production",
    "build:android:production-apk": "npx eas build --platform android --profile production-apk",
    "submit:android:production": "npx eas submit --platform android --profile production",
    "build:ios:production": "node ../../scripts/apple/build-approved-ios.mjs",
    "submit:ios:production": "node ../../scripts/apple/submit-approved-ios-build.mjs",
    "postinstall": "node scripts/patch-image-size-security.cjs"
  },
  "dependencies": {
