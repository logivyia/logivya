{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@logivya/logging/*": ["../../packages/logging/src/*"],
      "@logivya/logging": ["../../packages/logging/src/index.ts"],
      "@logivya/validation/*": ["../../packages/validation/src/*"]
    },
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["App.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
