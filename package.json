    "test:enterprise-subscription": "tsx scripts/test-enterprise-subscription.ts",
    "test:team-contact-messaging:integration": "tsx scripts/test-team-contact-integration.ts",
    "test:team-contact-messaging:api": "tsx scripts/test-team-contact-api-smoke.ts",
    "audit:seven-day-trial": "tsx scripts/audit-seven-day-trial-migration.ts",
    "audit:team-contact-migration": "tsx scripts/audit-team-contact-migration.ts",
    "proof:professional-contacts": "tsx scripts/proof-professional-contact-directory.ts",
    "audit:category-contact-migration": "tsx scripts/audit-category-contact-migration.ts",
