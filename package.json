    "i18n:build": "node scripts/build-localization-catalogs.mjs --write",
    "i18n:check": "node scripts/audit-localization.mjs --check",
    "test:i18n": "npm run i18n:check && tsx scripts/test-localization-contracts.ts",
    "test:email": "tsx scripts/test-email.ts",
