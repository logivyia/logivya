# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_ENV=development
NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0
NEXT_PUBLIC_APP_VERSION=0.1.0
AUTH_SECRET=replace-with-at-least-32-random-characters
# Legacy aliases are optional; prefer AUTH_SECRET unless an existing deployment requires them.
NEXTAUTH_SECRET=
MOBILE_JWT_SECRET=
MOBILE_AUTH_SECRET=replace-with-a-separate-at-least-32-random-character-secret
SESSION_ENCRYPTION_KEY=replace-with-32-byte-key
PASSWORD_PEPPER=replace-with-at-least-32-random-characters
MFA_RECOVERY_CODE_PEPPER=replace-with-a-separate-at-least-32-random-character-secret
MFA_FIELD_ENCRYPTION_ACTIVE_VERSION=v1
MFA_FIELD_ENCRYPTION_KEY_V1=replace-with-a-dedicated-base64url-encoded-32-byte-key
FIELD_ENCRYPTION_ACTIVE_VERSION=v1
# Base64url-encoded 32-byte AES key
FIELD_ENCRYPTION_KEY_V1=replace-with-base64url-encoded-32-byte-key
# Dedicated HMAC secret for pseudonymous trial identity matching. Falls back to AUTH_SECRET during rollout.
TRIAL_IDENTITY_HASH_KEY=replace-with-a-separate-at-least-32-random-character-secret
# Optional dedicated private-field key; FIELD_ENCRYPTION_KEY_V1 remains preferred.
TRIAL_FIELD_ENCRYPTION_KEY=
SEAT_ROTATION_MAX_PER_DAY=5
SEAT_ROTATION_MAX_PER_MONTH=20
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters
PLATFORM_ADMIN_EMAILS=admin@example.com
INITIAL_PLATFORM_ADMIN_EMAIL=
INITIAL_PLATFORM_ADMIN_NAME=
CRON_SECRET=replace-with-at-least-32-random-characters

# Data and queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logivya
REDIS_URL=redis://localhost:6379
# PostgreSQL is the durable scheduling source. These values control worker reconciliation after Redis loss.
QUEUE_RECOVERY_INTERVAL_MS=60000
QUEUE_RECOVERY_BATCH_SIZE=500
QUEUE_RECOVERY_STALE_CLAIM_MS=600000
QUEUE_HEALTH_CACHE_MS=5000
QUEUE_HEALTH_STALE_CACHE_MS=30000
QUEUE_HEALTH_TIMEOUT_MS=5000

# Internal production monitoring. Keep token values server-side only.
MONITORING_INTERNAL_TOKEN=
MONITORING_PROBE_TIMEOUT_MS=8000
MONITORING_RECOVERY_CONSECUTIVE_CHECKS=2
DB_HEALTH_DEGRADED_MS=500
DB_HEALTH_UNAVAILABLE_MS=2000
REDIS_HEALTH_DEGRADED_MS=250
REDIS_HEALTH_UNAVAILABLE_MS=1000
MONITORING_GITHUB_REPOSITORY=logivyia/logivya
GITHUB_MONITORING_TOKEN=
# Test-only integration gates.
MONITORING_TEST_BASE_URL=
OBSERVABILITY_DB_INTEGRATION=0

# Provider and storage
WHATSAPP_PROVIDER=baileys
WHATSAPP_WORKER_URL=
WHATSAPP_SESSION_SECRET=replace-with-at-least-32-random-characters
WHATSAPP_SESSION_DIR=./sessions
WHATSAPP_SESSION_ROOT=
# Set true only when WHATSAPP_SESSION_DIR is mounted on durable worker storage.
WHATSAPP_SESSION_VOLUME_PERSISTENT=false
WHATSAPP_MIN_DELAY_MS=3000
WHATSAPP_MAX_DELAY_MS=9000
WHATSAPP_MAX_MESSAGES_PER_MINUTE=12
WHATSAPP_MAX_DAILY_MESSAGES=500
WHATSAPP_MESSAGE_ATTEMPTS=8
WHATSAPP_MESSAGE_RETRY_DELAY_MS=5000
WHATSAPP_DELETE_ATTEMPTS=5
WHATSAPP_DELETE_RETRY_DELAY_MS=10000
WHATSAPP_DELETE_FOR_EVERYONE_WINDOW_MS=172800000
WHATSAPP_RECOVERABLE_RETRY_DELAY_MS=20000
SCHEDULED_MESSAGE_ATTEMPTS=6
SCHEDULED_MESSAGE_RETRY_DELAY_MS=600000
WHATSAPP_ACCOUNT_LOCK_TTL_MS=180000
WHATSAPP_ACCOUNT_LOCK_TIMEOUT_MS=45000
WHATSAPP_ACCOUNT_LOCK_RETRY_DELAY_MS=250
WHATSAPP_SESSION_RECOVERY_INTERVAL_MS=180000
WHATSAPP_ON_DEMAND_RESTORE_STALE_MS=60000
WHATSAPP_ON_DEMAND_RESTORE_THROTTLE_MS=30000
MOBILE_WA_ACCOUNT_RESTORE_TIMEOUT_MS=15000
WHATSAPP_HEARTBEAT_INTERVAL_MS=30000
WHATSAPP_SOCKET_INITIALIZATION_TIMEOUT_MS=90000
WHATSAPP_MISSING_CREDENTIALS_GRACE_ATTEMPTS=3
WHATSAPP_CONTACT_BOOTSTRAP_ACTIVE_DELIVERY_WINDOW_MS=120000
WHATSAPP_CONTACT_BOOTSTRAP_QUIET_MS=1500
WHATSAPP_CONTACT_BOOTSTRAP_WAIT_MS=30000
WHATSAPP_CONTACT_EVENT_BUFFER_WAIT_MS=1500
WHATSAPP_CONTACT_HISTORY_FALLBACK_COOLDOWN_MS=600000
WHATSAPP_CONTACT_HISTORY_FALLBACK_MIN_NAMED=25
WHATSAPP_CONTACT_OPEN_SYNC_STALE_MS=600000
WHATSAPP_COUNTRY_CODE=90
WHATSAPP_PAIRING_COUNTRY_CODE=90
WHATSAPP_PAIRING_BROWSER_NAME=Chrome
WHATSAPP_PAIRING_BROWSER_OS=ubuntu
WHATSAPP_PAIRING_CODE_MIN_TTL_MS=120000
WHATSAPP_PAIRING_CODE_REISSUE_RETRY_MS=10000
WHATSAPP_PAIRING_CODE_STABILITY_MS=3000
WHATSAPP_PAIRING_CODE_TTL_MS=300000
WHATSAPP_PAIRING_IN_FLIGHT_MS=120000
WHATSAPP_PAIRING_PRESERVED_CODE_RETRY_MS=10000
WHATSAPP_PAIRING_REGISTERED_RECONNECT_LIMIT=3
WHATSAPP_PAIRING_SOCKET_BOOTSTRAP_MS=3000
WHATSAPP_PAIRING_TRANSIENT_RETRY_LIMIT=5
WHATSAPP_PAIRING_WAIT_ATTEMPTS=30
WHATSAPP_PHONE_PAIRING_GUARD_MS=180000
WHATSAPP_PHONE_PAIRING_QR_REF_TIMEOUT_MS=30000
WHATSAPP_QR_TRANSIENT_RETRY_LIMIT=5
WHATSAPP_QR_WAIT_ATTEMPTS=30
WORKER_HEALTH_PORT=3001
WORKER_HEALTH_URL=
WORKER_ID=
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_HEARTBEAT_TTL_SECONDS=90
WORKER_HEARTBEAT_FRESH_MS=60000
ALLOW_LOCAL_PRODUCTION_WORKER=0
GIT_COMMIT=
RENDER_GIT_COMMIT=
VERCEL_GIT_COMMIT_SHA=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Transactional email
EMAIL_PROVIDER=SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@logivya.com
SMTP_SECURE=false
RESEND_API_KEY=
EMAIL_FROM_NAME=Logivya
EMAIL_FROM_ADDRESS=no-reply@logivya.com
EMAIL_FROM=no-reply@logivya.com
NOTIFICATION_RETENTION_DAYS=365
NOTIFICATION_DEVICE_RETENTION_DAYS=90
NOTIFICATION_WEBHOOK_SECRET_RESEND=
NOTIFICATION_WEBHOOK_SECRET_EXPO=
EXPO_ACCESS_TOKEN=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:logivya@gmail.com
NOTIFICATION_WORKER_POLL_MS=5000
NOTIFICATION_WORKER_REQUIRED=true
NOTIFICATION_WORKER_ID=
NOTIFICATION_PROCESSING_MODE=worker
NOTIFICATION_CRON_HEARTBEAT_MAX_AGE_MS=93600000
WEB_PUSH_SUBJECT=mailto:support@logivya.com
# SMS password reset delivery is provider-ready but disabled until configured.
SMS_PROVIDER=
SUPPORT_EMAIL=support@logivya.com
BILLING_EMAIL=billing@logivya.com

# Payment webhooks fail closed until the selected provider secrets are configured.
STRIPE_WEBHOOK_SECRET=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
IYZICO_API_URL=https://api.iyzipay.com

# Optional product-approved attribution appended only for advertising-enabled plans.
MESSAGE_ADVERTISING_ATTRIBUTION_TEXT=

# Encrypted PostgreSQL backup and restore
BACKUP_ENVIRONMENT=development
BACKUP_STORAGE_PROVIDER=s3-compatible
BACKUP_OUTPUT_DIR=artifacts/backups
BACKUP_POSTGRES_TOOLS=docker
BACKUP_POSTGRES_IMAGE=postgres:17
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
# Optional when Docker tools need a different route to the same database than the Node process.
BACKUP_DOCKER_DATABASE_HOST=
BACKUP_DOCKER_DATABASE_PORT=
BACKUP_RETENTION_DAYS=14
# Base64/base64url/hex encoded 32-byte AES key. Keep this outside application runtime credentials.
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-random-key
BACKUP_ENCRYPTION_KEY_ID=backup-v1
BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_REGION=auto
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_ACCESS_KEY=
BACKUP_STORAGE_SECRET_KEY=
BACKUP_STORAGE_FORCE_PATH_STYLE=false
BACKUP_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
BACKUP_STORAGE_KMS_KEY_ID=
BACKUP_STORAGE_PREFIX=logivya-backups
BACKUP_SECONDARY_STORAGE_ENDPOINT=
BACKUP_SECONDARY_STORAGE_REGION=auto
BACKUP_SECONDARY_STORAGE_BUCKET=
BACKUP_SECONDARY_STORAGE_ACCESS_KEY=
BACKUP_SECONDARY_STORAGE_SECRET_KEY=
BACKUP_SECONDARY_STORAGE_FORCE_PATH_STYLE=false
BACKUP_SECONDARY_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
BACKUP_SECONDARY_STORAGE_KMS_KEY_ID=
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALLOW_LOCAL_PRODUCTION_OUTPUT=0

# Privacy exports and governance. Use a dedicated private R2 bucket and credentials.
PRIVACY_EXPORT_S3_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
PRIVACY_EXPORT_S3_REGION=auto
PRIVACY_EXPORT_S3_BUCKET=logivya-privacy-exports
PRIVACY_EXPORT_S3_ACCESS_KEY_ID=
PRIVACY_EXPORT_S3_SECRET_ACCESS_KEY=
# Base64/base64url/hex encoded 32-byte AES master key. Rotate by adding key-version support before changing an active key.
PRIVACY_EXPORT_ENCRYPTION_KEY=replace-with-32-byte-random-key
PRIVACY_EXPORT_KEY_VERSION=privacy-export-v1
PRIVACY_OPERATIONAL_RESPONSE_DAYS=30
PRIVACY_DELETION_DELAY_DAYS=7
# Keep false until counsel-approved periods, legal-hold tests, backup and restore rehearsal have passed.
PRIVACY_RETENTION_ENFORCEMENT=false

# Restore commands fail closed unless an isolated target is confirmed.
RESTORE_CONFIRM_ISOLATED=NO
RESTORE_DATABASE_URL=
RESTORE_ALLOWED_HOSTS=
RESTORE_DOCKER_CONTAINER=
RESTORE_DATABASE_NAME=logivya_restore
RESTORE_DATABASE_USER=postgres

# Operations
MAINTENANCE_MODE=false
SUPER_ADMIN_EMAIL=burakidim@gmail.com
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_2FA_REQUIRED=false
ADMIN_DELEGATED_ROLES_ENABLED=false

# Mobile build-time configuration. EXPO_PUBLIC values are bundled and must never contain secrets.
EXPO_PUBLIC_API_BASE_URL=https://www.logivya.com
EXPO_PUBLIC_APP_NAME=Logivya
EXPO_PUBLIC_APP_VERSION=1.0.105
EXPO_PUBLIC_EAS_OWNER=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_DISABLE_HERMES=false
EXPO_PUBLIC_DISABLE_NEW_ARCH=false
EXPO_PUBLIC_NATIVE_DIAGNOSTIC=false
EXPO_PUBLIC_STARTUP_TEST=false
ANDROID_VERSION_CODE=135
IOS_BUILD_NUMBER=135
EAS_BUILD_PROFILE=production
GITHUB_SHA=
LOGIVYA_GIT_COMMIT=
LOGIVYA_BUILD_DATE=
LOGIVYA_API_CONTRACT_VERSION=
LOGIVYA_RELEASE_ID=

# Android release verification inputs. Keep certificate fingerprints public; never store signing keys here.
BUNDLETOOL_JAR=
EXPECTED_UPLOAD_CERT_SHA256=
PLAY_LATEST_VERSION_CODE=
LOGIVYA_AAB_PATH=
LOGIVYA_RELEASE_MANIFEST_OUTPUT=
LOGIVYA_RELEASE_PREFLIGHT_OUTPUT=
LOGIVYA_RELEASE_ALLOW_DIRTY=false

# Mobile version policy returned by backend APIs.
MOBILE_CURRENT_VERSION=1.0.105
MOBILE_MINIMUM_VERSION=1.0.93
MOBILE_MIN_SUPPORTED_VERSION=1.0.93
MOBILE_RECOMMENDED_VERSION=1.0.105
MOBILE_FORCE_UPDATE=false
MOBILE_ANDROID_UPDATE_URL=
MOBILE_IOS_UPDATE_URL=

# Deployment and diagnostic scripts; configure only in the corresponding job.
VERCEL=
VERCEL_ENV=
VERCEL_DEPLOYMENT_ID=
RENDER_SERVICE_ID=
RENDER_SERVICE_NAME=
DEPLOYMENT_ID=
SOURCE_COMMIT=
API_BASE_URL=
SMOKE_BASE_URL=
AUTH_TEST_BASE_URL=
SUPPORT_TEST_BASE_URL=
CATEGORY_CONTACT_API_BASE_URL=
CONTACT_SYNC_API_BASE_URL=
CONTACT_SYNC_PROOF_ACCOUNT_PREFIX=
MOBILE_AUTH_INTEGRATION_BASE_URL=
MOBILE_REFRESH_RECOVERY_ACTIVE_VERSION=v1
PAIRING_POLL_COUNT=30
PAIRING_POLL_INTERVAL_MS=2000
SUPPORT_LOAD_READS=10
SUPPORT_LOAD_USERS=5

# Release acceptance evidence references. Populate only with real, reviewable proof IDs or URLs.
LOGIVYA_OWNER_APPROVAL_REFERENCE=
LOGIVYA_ANDROID_ACCEPTANCE_REFERENCE=
LOGIVYA_MOBILE_WEB_ACCEPTANCE_REFERENCE=
LOGIVYA_DESKTOP_WEB_ACCEPTANCE_REFERENCE=
LOGIVYA_WORKER_REDIS_ACCEPTANCE_REFERENCE=
LOGIVYA_DATABASE_ACCEPTANCE_REFERENCE=
LOGIVYA_PLAY_ACCEPTANCE_REFERENCE=

# Localization build controls.
L10N_OFFLINE_ONLY=false
L10N_TARGET_LOCALES=
TRANSLATION_CONTACT_EMAIL=

# Destructive integration-test guards. Use only with localhost disposable services.
CI=false
QUEUE_RECOVERY_INTEGRATION=0
WHATSAPP_SNAPSHOT_INTEGRATION=0
WORKER_RESTART_INTEGRATION=0
MIGRATION_FAILURE_INTEGRATION=0
ALLOW_PRODUCTION_AUTH_INTEGRATION_TEST=false
# Privacy-safe structured logging and observability
LOG_LEVEL=info
LOG_SERVICE_NAME=logivya-web
LOG_ENVIRONMENT=production
LOG_RELEASE_VERSION=
LOG_INCLUDE_STACKS=true
OBSERVABILITY_HASH_KEY=
SECURITY_EVENT_RETENTION_DAYS=
OPERATIONAL_ALERT_RETENTION_DAYS=
LOG_RETENTION_ENFORCEMENT=false
