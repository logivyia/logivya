# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/apps/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-stale-*/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.p8
*.p12
*.cer
*.mobileprovision
.private_keys/
.appstoreconnect/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files; keep the redacted template
.env*
!.env.example

# application logs and runtime data
.logs/
.tools/
logs/
*.log
*.pid
*.pid.lock
dump.rdb
appendonly.aof

# WhatsApp and channel provider sessions
/sessions/
/session/
/whatsapp-sessions/
/whatsapp-session/
/auth_info_baileys/
/.wwebjs_auth/
/.wwebjs_cache/
/.cache/
/qr/
/qrcodes/
/temp-qr/
/tmp/
/temp/
*.session
*.session.json
*.qr

# generated and distribution output
/dist/
/build/
/worker/dist/
/apps/*/dist/
/packages/*/dist/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Expo local state
.expo/
.local-android/

# Apple/EAS local credentials and generated signing material
credentials.json
apps/mobile/credentials.json
apps/mobile/GoogleService-Info.plist
apps/mobile/.eas-credentials/

# Android release artifacts and local signing/service configuration
*.aab
/artifacts/backups/
/artifacts/restore-tests/
/artifacts/releases/
encrypted-postgres-backup-*.zip
restore-proof-*.zip
*.apk
/apps/mobile/google-services.json
/apps/mobile/android/app/google-services.json
/apps/mobile/android/app/debug.keystore
/apps/mobile/android/windows-native-untracked.init.gradle
/apps/mobile/android/.cxx/
/apps/mobile/android/app/.cxx/
/apps/mobile/android/app/.cxx-stale-*/
/apps/mobile/android/app/build/

# Root-level files generated by local EAS inspection/build attempts
/.easignore
/app.json
/mobillogo.png
/mobillogo1.png
# Local EAS archive inspection output
apps/mobile/.eas-inspect-*/
