{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/support-notifications",
      "schedule": "17 2 * * *"
    },
    {
      "path": "/api/cron/invitation-delivery",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/monitoring",
      "schedule": "37 4 * * *"
    },
    {
      "path": "/api/cron/privacy-maintenance",
      "schedule": "47 5 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "7 2 * * *"
    }
  ]
}
